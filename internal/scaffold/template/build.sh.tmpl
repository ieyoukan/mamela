#!/usr/bin/env bash
# Builds the provider into its Pome (pome/provider.wasm), writes its sha256 into
# pome/mamela-provider.toml, and generates the Pome's Emela (pome/src/lib.emel) from its manifest.
# The build is reproducible: TestPomeIsTheBuild checks that what is committed is this build.
set -euo pipefail
cd "$(dirname "$0")"
# The same source and the same Go give the same bytes: build with exactly this Go.
want_go=go1.27.3
got_go="$(go env GOVERSION)"
if [[ "$got_go" != "$want_go" ]]; then
  echo "build with $want_go (this is $got_go): GOTOOLCHAIN=$want_go ./build.sh" >&2
  exit 1
fi
out=pome/provider.wasm
GOOS=wasip1 GOARCH=wasm go build -trimpath -buildvcs=false -o "$out" ./cmd/<% .Pkg %>-provider
sum="$(shasum -a 256 "$out" | cut -d' ' -f1)"
version="$(sed -n 's/^\tVersion = "\(.*\)"$/\1/p' <% .Pkg %>/<% .Pkg %>.go)"
cat > pome/mamela-provider.toml <<TOML
# The provider program of this Pome. Mamela runs it isolated (WASM) and checks this sha256;
# Pome.lock and the sumdb pin the whole Pome, this file and the program included.
provider = "<% .Provider %>"
version = "$version"
program = "provider.wasm"
sha256 = "$sum"

# The catalog of the API (ADR 0008 of Mamela): what each call does. Mamela classifies the program's
# requests with it only when the operator names it (mamela.providers.toml: catalog = "pome:<% .CatalogName %>").
[catalogs]
<% .CatalogName %> = "catalogs/<% .CatalogFile %>"
TOML
# The Pome's types and functions, from the kinds' specs.
go tool mamela provider pome pome
echo "$out $sum (version $version)"
