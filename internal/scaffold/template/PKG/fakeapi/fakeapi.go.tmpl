// Package fakeapi is an in-memory fake of the API <% .API %>, for the provider's tests: replace it
// with a fake of your API (only what the provider calls, with the API's answers and errors).
package fakeapi

import (
	"encoding/json/v2"
	"net/http"
	"slices"
	"strconv"
	"strings"
	"sync"
)

// Thing is one thing.
type Thing struct {
	Name    string   `json:"name"`
	Value   string   `json:"value"`
	Tags    []string `json:"tags,omitempty"`
	Owner   string   `json:"owner,omitempty"`
	Version int      `json:"version"`
}

// Server is the API, in memory.
type Server struct {
	mu     sync.Mutex
	things map[string]*Thing
}

// New returns an empty API.
func New() *Server { return &Server{things: map[string]*Thing{}} }

// Put stores a thing as is (a world that exists before Mamela).
func (s *Server) Put(t Thing) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.things[t.Name] = &t
}

// Things returns a copy of the things.
func (s *Server) Things() map[string]Thing {
	s.mu.Lock()
	defer s.mu.Unlock()
	out := map[string]Thing{}
	for k, v := range s.things {
		out[k] = *v
	}
	return out
}

func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	s.mu.Lock()
	defer s.mu.Unlock()
	mux := http.NewServeMux()
	mux.HandleFunc("GET /things", func(w http.ResponseWriter, r *http.Request) {
		out := []Thing{}
		for _, t := range s.things {
			out = append(out, *t)
		}
		slices.SortFunc(out, func(a, b Thing) int { return strings.Compare(a.Name, b.Name) })
		reply(w, http.StatusOK, out)
	})
	// version is the precondition: the current version, or 0 for "must not exist yet".
	matches := func(r *http.Request, t *Thing) bool {
		v := r.URL.Query().Get("version")
		if t == nil {
			return v == "0"
		}
		return v == strconv.Itoa(t.Version)
	}
	mux.HandleFunc("PUT /things/{thing}", func(w http.ResponseWriter, r *http.Request) {
		name := r.PathValue("thing")
		t := s.things[name]
		if !matches(r, t) {
			reply(w, http.StatusConflict, map[string]string{"error": "version mismatch"})
			return
		}
		var body struct {
			Value string   `json:"value"`
			Tags  []string `json:"tags"`
			Owner string   `json:"owner"`
		}
		if err := json.UnmarshalRead(r.Body, &body, json.RejectUnknownMembers(true)); err != nil {
			reply(w, http.StatusBadRequest, map[string]string{"error": err.Error()})
			return
		}
		if t == nil {
			t = &Thing{Name: name}
			s.things[name] = t
		}
		if body.Owner != "" {
			t.Owner = body.Owner // set when it is created, or when it is taken over
		}
		t.Value, t.Tags = body.Value, slices.Sorted(slices.Values(body.Tags))
		t.Version++
		reply(w, http.StatusOK, t)
	})
	mux.HandleFunc("DELETE /things/{thing}", func(w http.ResponseWriter, r *http.Request) {
		t := s.things[r.PathValue("thing")]
		if t == nil || !matches(r, t) {
			reply(w, http.StatusConflict, map[string]string{"error": "version mismatch"})
			return
		}
		delete(s.things, t.Name)
		reply(w, http.StatusOK, map[string]string{})
	})
	mux.ServeHTTP(w, r)
}

func reply(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	json.MarshalWrite(w, v, json.Deterministic(true))
}
