name: ci
on:
  push:
  pull_request:
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      # The Go that builds pome/provider.wasm (build.sh): another release gives another program.
      - uses: actions/setup-go@v5
        with:
          go-version: "1.27.3"
      - name: Mamela's pinned toolchain (emela, wasmtime)
        run: go tool mamela toolchain install --dir "$PWD/.tools/bin" --downloads "$PWD/.tools/downloads"
      - name: Test
        env:
          GOTOOLCHAIN: local
          MAMELA_TOOLCHAIN_DIR: ${{ github.workspace }}/.tools/bin
        run: go vet ./... && go test ./...
