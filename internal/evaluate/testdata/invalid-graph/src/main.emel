# Type-checks, but declares values Mamela refuses: a machine whose name is not a resource name,
# a package on a node that is not declared, and a package name with a shell metacharacter. All
# three must be reported at once.
import Std.Console.{SystemConsole}
import Mamela.{Node}

fn main() {
  with SystemConsole {
    Mamela.empty()
      |> Mamela.provided("test", "TestVM", "../web", [])
      |> Mamela.package(Node(name: "web"), "nginx;reboot")
      |> Mamela.print
  }
}
