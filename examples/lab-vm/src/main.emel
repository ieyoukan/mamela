# The first live test (lab L1): one small VM, created from the pinned Ubuntu 24.04 cloud image.
# No packages or services yet: those need the agent (step 3).

import Std.Console.{SystemConsole}
import Mamela.{Vm}

fn infrastructure() -> Mamela.Graph {
  Mamela.empty()
    |> Mamela.vm(
      Vm(name: "mamela-l1", cpu: 1, memory_mib: 1024, disk_gib: 10, image: "ubuntu-24.04"),
    )
}

fn main() {
  with SystemConsole {
    infrastructure() |> Mamela.print
  }
}
