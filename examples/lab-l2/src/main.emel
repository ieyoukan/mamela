# Lab L2: a VM with mamelet (the Mamela agent), and nginx installed, enabled and running on it.
# Installing nginx, enabling and starting it each need an approved plan; the plan shows exactly
# which packages apt would install.

import Std.Console.{SystemConsole}
import Mamela.{Vm}

fn infrastructure() -> Mamela.Graph {
  web = Vm(name: "mamela-l2", cpu: 1, memory_mib: 1024, disk_gib: 10, image: "ubuntu-24.04")

  Mamela.empty()
    |> Mamela.vm(web)
    |> Mamela.package(web, "nginx")
    |> Mamela.service(web, "nginx", True, True)
}

fn main() {
  with SystemConsole {
    infrastructure() |> Mamela.print
  }
}
