# A light Kubernetes cluster: a k3s server and two agents, one VM each (no ingress controller, no
# metrics server). mamelet installs the k3s release pinned below only after approval and only if
# the binary's sha256 matches; the Control Plane gives the nodes their join token and each agent
# its server's address. Starting k3s is a separate approval.
#
# The sha256 is the release's, for linux/amd64 (sha256sum-amd64.txt of the release).

import Std.Console.{SystemConsole}
import Mamela.{Vm, Dhcp}

const K3S_VERSION = "v1.37.2+k3s1"
const K3S_SHA256 = "265b3ee6a3198ef14033c63ef46cbb32370d83795199fb6d1b01f21575eddbda"

fn infrastructure() -> Mamela.Graph {
  server = Vm(
    name: "k3s-server",
    cpu: 2,
    memory_mib: 4096,
    disk_gib: 20,
    image: "ubuntu-24.04",
    network: Dhcp,
  )
  agent1 = Vm(
    name: "k3s-agent-1",
    cpu: 2,
    memory_mib: 2048,
    disk_gib: 20,
    image: "ubuntu-24.04",
    network: Dhcp,
  )
  agent2 = Vm(
    name: "k3s-agent-2",
    cpu: 2,
    memory_mib: 2048,
    disk_gib: 20,
    image: "ubuntu-24.04",
    network: Dhcp,
  )

  Mamela.empty()
    |> Mamela.vm(server)
    |> Mamela.vm(agent1)
    |> Mamela.vm(agent2)
    |> Mamela.k3s_server(server, K3S_VERSION, K3S_SHA256)
    |> Mamela.k3s_agent(agent1, server, K3S_VERSION, K3S_SHA256)
    |> Mamela.k3s_agent(agent2, server, K3S_VERSION, K3S_SHA256)
    |> Mamela.service(server, "k3s", True, True)
    |> Mamela.service(agent1, "k3s", True, True)
    |> Mamela.service(agent2, "k3s", True, True)
}

fn main() {
  with SystemConsole {
    infrastructure() |> Mamela.print
  }
}
