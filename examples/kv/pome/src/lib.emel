## Kv: the resources of the Mamela provider "kv-example", version 0.1.0.
##
## Code generated by `mamela provider pome` from the provider's manifest; DO NOT EDIT.
## Importing this Pome is how a declaration uses the provider: the functions here declare its
## resources, and the Pome holds the provider's program (mamela-provider.toml), which Mamela runs
## isolated. A field that refers to another resource takes its value, so that the reference names
## something declared; Mamela plans a resource once those it refers to exist.

import Mamela
import Mamela.{Ref}
import Dynamic.{Dynamic, Text, Items}

## The provider, as its manifest names it.
pub const PROVIDER = "kv-example"

## An item of the key-value API: its value, and its labels.
##
## `value`: the item's value
## `labels`: its labels (none declared: not managed) (optional)
pub type KvItem(name: String, value: String, labels: List[String])

## Declares the KVItem: Mamela makes it so, through the provider.
pub fn kv_item(graph: Mamela.Graph, r: KvItem) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("value", Text(r.value))],
      if List.is_empty(r.labels) { [] } else { [("labels", Items(r.labels.map(|x| Text(x))))] },
    ],
  )
  Mamela.provided(graph, PROVIDER, "KVItem", r.name, spec)
}

## A reference to the KVItem, for what needs it first.
pub fn kv_item_ref(r: KvItem) -> Ref {
  Ref(kind: "KVItem", name: r.name)
}
