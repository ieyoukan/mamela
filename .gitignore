# Local state and secrets
/.mamela/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.pem
*.key
.env
.env.*
!.env.example

# Build outputs
target/
/bin/
/dist/
/tmp/

# Lab site-specific values (hostnames, addresses, token paths)
/lab/*.local.toml
/lab/local/

# Pinned toolchain (scripts/install-toolchain.sh)
/.tools/

# The site (mamela.site.example.toml is the template)
/mamela.site.toml

# Local builds of the CLI (go build ./cmd/mamela)
/mamela

# The providers' APIs and credential paths of a site (site-specific)
/mamela.providers.toml
