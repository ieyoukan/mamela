## Mamela: declare the desired state of infrastructure as a graph, and print it as one
## `mamela-graph/v1` JSON document on standard output (`mamela-graph/v2` when it has resources
## of providers).
##
## Building a graph is pure. Only `print` uses an effect (`Console`), so evaluating a
## declaration cannot touch the network, files, the clock or randomness.

import Std.Console.{Console}
import Dynamic.{Dynamic, Text, Items}
import Dynamic.Number
import Json

## The schema written in the `schema` field. The Go side rejects any other value.
pub const SCHEMA = "mamela-graph/v1"

## The schema of a graph with resources of providers.
pub const SCHEMA_V2 = "mamela-graph/v2"

## How a machine gets its IPv4 address, given to it when it is created. There is no default: a
## declaration says `Dhcp` or `Static(...)`. `address` has its prefix length ("192.0.2.10/24"),
## `gateway` is in its subnet, and `dns` names 1 to 3 name servers. A site may allow static
## addresses only from a range of its own. A provider's Pome writes it into its machine's spec as
## `("network", Mamela.network_spec(network))`, where Mamela checks it.
pub enum Network {
  Dhcp
  Static(address: String, gateway: String, dns: List[String])
}

## An APT package that should be present on a node.
pub type Package(node: String, name: String)

## A systemd service on a node.
pub type Service(node: String, name: String, enabled: Bool, running: Bool)

## A reference to a resource of a provider: its kind and name. A provider's Pome makes it from its
## own typed values (`Aws.cluster_ref(c)`), so that a reference names something declared.
pub type Ref(kind: String, name: String)

## A resource of a provider's kind, and the resources it needs first (`after`). A provider's Pome
## wraps `provided` in typed functions, so that a declaration writes `Kv.kv_item(...)`, not this.
pub type Provided(
  provider: String,
  kind: String,
  name: String,
  spec: List[(String, Dynamic)],
  after: List[Ref],
)

## A resource of a built-in kind that lives on a node (what mamelet does there), for Mamela's own
## role Pomes such as `K3s`. Mamela accepts only the built-in kinds it knows.
pub type OnNode(kind: String, name: String, spec: List[(String, Dynamic)])

## The desired state. Resources keep the order in which they were added.
pub opaque type Graph(
  packages: List[Package],
  services: List[Service],
  on_nodes: List[OnNode],
  by_providers: List[Provided],
)

pub fn empty() -> Graph {
  Graph(packages: [], services: [], on_nodes: [], by_providers: [])
}

## Declares a resource of a provider: `kind` is a kind of the provider named `provider`, and
## `spec` its fields (strings, integers, booleans, lists and objects). Mamela passes the spec to
## the provider, which says what would change; Mamela checks every request it then sends.
pub fn provided(
  graph: Graph,
  provider: String,
  kind: String,
  name: String,
  spec: List[(String, Dynamic)],
) -> Graph {
  provided_after(graph, provider, kind, name, spec, [])
}

## Declares a resource of a provider that needs other resources first: Mamela plans it once each
## of them exists and is Mamela's, and gives the provider their IDs (a security group's, a
## cluster's) to write into its changes.
pub fn provided_after(
  graph: Graph,
  provider: String,
  kind: String,
  name: String,
  spec: List[(String, Dynamic)],
  after: List[Ref],
) -> Graph {
  r = Provided(provider:, kind:, name:, spec:, after:)
  Graph(by_providers: List.append(graph.by_providers, [r]), ..graph)
}

## Declares a resource of a built-in kind on `node`, for Mamela's own role Pomes (`K3s`).
pub fn on_node(
  graph: Graph,
  node: Node,
  kind: String,
  name: String,
  spec: List[(String, Dynamic)],
) -> Graph {
  r = OnNode(kind:, name:, spec: List.append([("node", Text(node.name))], spec))
  Graph(on_nodes: List.append(graph.on_nodes, [r]), ..graph)
}

## Declares the mamelet release `node` runs, by the sha256 of its binary (the one the Control Plane
## serves: the site's `controlplane.mamelet_binary`). `version` is a label for people. A node that
## runs another mamelet is updated, with an approval, one node at a time; the node keeps its
## previous binary and goes back to it if the new one does not report.
pub fn mamelet(graph: Graph, node: Node, version: String, sha256: String) -> Graph {
  on_node(
    graph,
    node,
    "NodeMamelet",
    "#{node.name}/mamelet",
    [("version", Text(version)), ("sha256", Text(sha256))],
  )
}

## A machine mamelet runs on: a machine a provider makes (its Pome gives a function that returns
## one, such as `Proxmox.node`). Taking a `Node` (not a name) keeps a reference from pointing at a
## machine that was never declared by a typo.
pub type Node(name: String)

## A file on a node (the linux extension's `NodeFile`): exactly `content` (text, at most 256 KiB) at
## the absolute `path`, with `mode` (four octal digits, without the setuid, setgid and sticky bits,
## not writable by everyone), `owner` and `group` (names that exist on the node), and the services of
## `restart` on the node restarted, if they run, after it changes. `file_of` makes one with the
## defaults, to change with `File(mode: "0640", ..Mamela.file_of(path, content))`.
pub type File(
  path: String,
  content: String,
  mode: String,
  owner: String,
  group: String,
  restart: List[String],
)

## A file at `path` with `content`, mode "0644", owned by root, that restarts nothing.
pub fn file_of(path: String, content: String) -> File {
  File(path:, content:, mode: "0644", owner: "root", group: "root", restart: [])
}

## Declares that `node` has the file at `path` with exactly `content`, mode "0644", owned by root
## (`file_with` declares another mode, owner, or services to restart). The plan shows the whole
## content and asks for an approval; changing it is a new approval. A file that is no longer
## declared stays on the node as it is. Mamela never writes through a symbolic link, and refuses
## the paths that are not files to write (the kernel's, mamelet's, k3s's, users and sudoers, the
## APT sources and keys named `mamela-*`, `.ssh/authorized_keys`). Keep secrets out: the content
## is in clear text in the plan and the Control Plane's database.
pub fn file(graph: Graph, node: Node, path: String, content: String) -> Graph {
  file_with(graph, node, file_of(path, content))
}

## Declares the file `f` on `node`.
pub fn file_with(graph: Graph, node: Node, f: File) -> Graph {
  restart = if List.is_empty(f.restart) {
    []
  } else {
    [("restart", Items(f.restart.map(Text)))]
  }
  on_node(
    graph,
    node,
    "NodeFile",
    "#{node.name}/file#{f.path}",
    List.append(
      [
        ("path", Text(f.path)),
        ("content", Text(f.content)),
        ("mode", Text(f.mode)),
        ("owner", Text(f.owner)),
        ("group", Text(f.group)),
      ],
      restart,
    ),
  )
}

## A file on a node downloaded over https and pinned by its sha256 (the linux extension's
## `NodeArtifact`): a release's binary at the absolute `path`, downloaded from `url` (https, without a
## user or a fragment), whose bytes have `sha256` (64 lowercase hex digits, as the release's checksum
## file lists them). With `extract`, the download is a gzip-compressed tar and only that member of it
## (a regular file, named as `tar -tzf` lists it) is installed; `""` installs the download itself.
## `mode`, `owner`, `group` and `restart` are as a `File`'s. `artifact_of` makes one with the
## defaults, to change with `Artifact(extract: "app-1.0/app", ..Mamela.artifact_of(path, url, sha256))`.
pub type Artifact(
  path: String,
  url: String,
  sha256: String,
  extract: String,
  mode: String,
  owner: String,
  group: String,
  restart: List[String],
)

## An artifact at `path`, the download of `url` with `sha256` itself, mode "0755", owned by root,
## that restarts nothing.
pub fn artifact_of(path: String, url: String, sha256: String) -> Artifact {
  Artifact(
    path:,
    url:,
    sha256:,
    extract: "",
    mode: "0755",
    owner: "root",
    group: "root",
    restart: [],
  )
}

## Declares that `node` has at `path` the download of `url` whose sha256 is `sha256`, mode "0755",
## owned by root (`artifact_with` declares a member of a `.tar.gz`, another mode, owner, or services
## to restart). The plan shows the URL and the sha256 and asks for an approval; mamelet installs
## nothing whose sha256 is another, and keeps a record of what it installed, so that a file changed
## by hand is installed again (with a new approval). An artifact that is no longer declared stays on
## the node as it is. The paths it may not be are a file's.
pub fn artifact(graph: Graph, node: Node, path: String, url: String, sha256: String) -> Graph {
  artifact_with(graph, node, artifact_of(path, url, sha256))
}

## Declares the artifact `a` on `node`.
pub fn artifact_with(graph: Graph, node: Node, a: Artifact) -> Graph {
  extract = if a.extract == "" {
    []
  } else {
    [("extract", Text(a.extract))]
  }
  restart = if List.is_empty(a.restart) {
    []
  } else {
    [("restart", Items(a.restart.map(Text)))]
  }
  on_node(
    graph,
    node,
    "NodeArtifact",
    "#{node.name}/artifact#{a.path}",
    List.append(
      [
        ("path", Text(a.path)),
        ("url", Text(a.url)),
        ("sha256", Text(a.sha256)),
        ("mode", Text(a.mode)),
        ("owner", Text(a.owner)),
        ("group", Text(a.group)),
      ],
      List.append(extract, restart),
    ),
  )
}

## Declares that `name` is installed on `node`.
pub fn package(graph: Graph, node: Node, name: String) -> Graph {
  Graph(packages: List.append(graph.packages, [Package(node: node.name, name:)]), ..graph)
}

## Declares a systemd service on `node`.
pub fn service(graph: Graph, node: Node, name: String, enabled: Bool, running: Bool) -> Graph {
  s = Service(node: node.name, name:, enabled:, running:)
  Graph(services: List.append(graph.services, [s]), ..graph)
}

fn integer(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}

fn boolean(b: Bool) -> Dynamic {
  Dynamic.Bool(b)
}

fn resource(kind: String, name: String, spec: List[(String, Dynamic)]) -> Dynamic {
  Dynamic.object([("kind", Text(kind)), ("name", Text(name)), ("spec", Dynamic.object(spec))])
}

## A network as a machine's spec writes it, for a provider's Pome.
pub fn network_spec(n: Network) -> Dynamic {
  n match {
    Dhcp -> Dynamic.object([("mode", Text("dhcp"))])
    Static(address: address, gateway: gateway, dns: dns) -> {
      Dynamic.object(
        [
          ("mode", Text("static")),
          ("address", Text(address)),
          ("gateway", Text(gateway)),
          ("dns", Items(dns.map(Text))),
        ],
      )
    }
  }
}

fn package_json(p: Package) -> Dynamic {
  resource(
    "NodePackage",
    "#{p.node}/#{p.name}",
    [("node", Text(p.node)), ("package", Text(p.name)), ("state", Text("Present"))],
  )
}

fn service_json(s: Service) -> Dynamic {
  resource(
    "NodeService",
    "#{s.node}/#{s.name}",
    [
      ("node", Text(s.node)),
      ("service", Text(s.name)),
      ("enabled", boolean(s.enabled)),
      ("running", boolean(s.running)),
    ],
  )
}

fn on_node_json(r: OnNode) -> Dynamic {
  resource(r.kind, r.name, r.spec)
}

fn ref_text(r: Ref) -> Dynamic {
  Text("#{r.kind} #{r.name}")
}

fn provided_json(p: Provided) -> Dynamic {
  fields = [
    ("kind", Text(p.kind)),
    ("name", Text(p.name)),
    ("provider", Text(p.provider)),
    ("spec", Dynamic.object(p.spec)),
  ]
  after = if List.is_empty(p.after) {
    []
  } else {
    [("after", Items(p.after.map(ref_text)))]
  }
  Dynamic.object(List.append(fields, after))
}

fn graph_json(graph: Graph) -> Dynamic {
  resources = List.append(
    graph.packages.map(package_json),
    List.append(
      graph.services.map(service_json),
      List.append(graph.on_nodes.map(on_node_json), graph.by_providers.map(provided_json)),
    ),
  )
  schema = if List.is_empty(graph.by_providers) { SCHEMA } else { SCHEMA_V2 }
  Dynamic.object([("schema", Text(schema)), ("resources", Items(resources))])
}

## The `mamela-graph/v1` (or v2) JSON text of `graph`, written by `x/json`: no whitespace, and object
## keys in sorted order (the order of `Map`).
pub fn to_json(graph: Graph) -> String {
  Json.to_string(graph_json(graph))
}

## Writes the graph as one line to standard output.
pub fn print(graph: Graph) {
  (use Console).print_line(to_json(graph))
}
