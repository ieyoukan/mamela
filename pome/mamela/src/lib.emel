## Mamela: declare the desired state of infrastructure as a graph, and print it as one
## `mamela-graph/v1` JSON document on standard output (`mamela-graph/v2` when it has resources
## of providers).
##
## Building a graph is pure. Only `print` uses an effect (`Console`), so evaluating a
## declaration cannot touch the network, files, the clock or randomness.

import Std.Console.{Console}
import Dynamic.{Dynamic, Text, Items}
import Dynamic.Number
import Json

## The schema written in the `schema` field. The Go side rejects any other value.
pub const SCHEMA = "mamela-graph/v1"

## The schema of a graph with resources of providers.
pub const SCHEMA_V2 = "mamela-graph/v2"

## How a machine gets its IPv4 address, given to it when it is created. There is no default: a
## declaration says `Dhcp` or `Static(...)`. `address` has its prefix length ("192.0.2.10/24"),
## `gateway` is in its subnet, and `dns` names 1 to 3 name servers. A site may allow static
## addresses only from a range of its own. A provider's Pome writes it into its machine's spec as
## `("network", Mamela.network_spec(network))`, where Mamela checks it.
pub enum Network {
  Dhcp
  Static(address: String, gateway: String, dns: List[String])
}

## An APT package that should be present on a node.
pub type Package(node: String, name: String)

## A systemd service on a node.
pub type Service(node: String, name: String, enabled: Bool, running: Bool)

## k3s (a light Kubernetes) on a node, as a server or as an agent of a server: this exact release,
## pinned by the sha256 of its binary for the node's architecture (from the release's sha256sum
## file). Mamela writes the systemd unit itself and gives the cluster's nodes their join token;
## start it with `service(graph, node, "k3s", True, True)`.
pub type K3s(node: String, role: String, server: String, version: String, sha256: String)

## A resource of a provider's kind. A provider's Pome wraps `provided` in typed functions, so
## that a declaration writes `Kv.item(...)`, not this.
pub type Provided(provider: String, kind: String, name: String, spec: List[(String, Dynamic)])

## The desired state. Resources keep the order in which they were added.
pub opaque type Graph(
  packages: List[Package],
  services: List[Service],
  k3s_servers: List[K3s],
  by_providers: List[Provided],
)

pub fn empty() -> Graph {
  Graph(packages: [], services: [], k3s_servers: [], by_providers: [])
}

## Declares a resource of a provider: `kind` is a kind of the provider named `provider`, and
## `spec` its fields (strings, integers, booleans, lists and objects). Mamela passes the spec to
## the provider, which says what would change; Mamela checks every request it then sends.
pub fn provided(
  graph: Graph,
  provider: String,
  kind: String,
  name: String,
  spec: List[(String, Dynamic)],
) -> Graph {
  r = Provided(provider:, kind:, name:, spec:)
  Graph(by_providers: List.append(graph.by_providers, [r]), ..graph)
}

## A machine mamelet runs on: a machine a provider makes (its Pome gives a function that returns
## one, such as `Proxmox.node`). Taking a `Node` (not a name) keeps a reference from pointing at a
## machine that was never declared by a typo.
pub type Node(name: String)

## Declares that `name` is installed on `node`.
pub fn package(graph: Graph, node: Node, name: String) -> Graph {
  Graph(packages: List.append(graph.packages, [Package(node: node.name, name:)]), ..graph)
}

## The same as `package` (the name of Mamela Pome 0.2).
pub fn package_on(graph: Graph, node: Node, name: String) -> Graph {
  package(graph, node, name)
}

## Declares that `node` runs a k3s server of `version`, whose binary has `sha256`.
pub fn k3s_server(graph: Graph, node: Node, version: String, sha256: String) -> Graph {
  k = K3s(node: node.name, role: "server", server: "", version:, sha256:)
  Graph(k3s_servers: List.append(graph.k3s_servers, [k]), ..graph)
}

## The same as `k3s_server` (the name of Mamela Pome 0.2).
pub fn k3s_server_on(graph: Graph, node: Node, version: String, sha256: String) -> Graph {
  k3s_server(graph, node, version, sha256)
}

## Declares that `node` runs a k3s agent of `version` that joins the server on `server`.
pub fn k3s_agent(graph: Graph, node: Node, server: Node, version: String, sha256: String) -> Graph {
  k = K3s(node: node.name, role: "agent", server: server.name, version:, sha256:)
  Graph(k3s_servers: List.append(graph.k3s_servers, [k]), ..graph)
}

## The same as `k3s_agent` (the name of Mamela Pome 0.2).
pub fn k3s_agent_on(
  graph: Graph,
  node: Node,
  server: Node,
  version: String,
  sha256: String,
) -> Graph {
  k3s_agent(graph, node, server, version, sha256)
}

## Declares a systemd service on `node`.
pub fn service(graph: Graph, node: Node, name: String, enabled: Bool, running: Bool) -> Graph {
  s = Service(node: node.name, name:, enabled:, running:)
  Graph(services: List.append(graph.services, [s]), ..graph)
}

## The same as `service` (the name of Mamela Pome 0.2).
pub fn service_on(graph: Graph, node: Node, name: String, enabled: Bool, running: Bool) -> Graph {
  service(graph, node, name, enabled, running)
}

fn integer(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}

fn boolean(b: Bool) -> Dynamic {
  Dynamic.Bool(b)
}

fn resource(kind: String, name: String, spec: List[(String, Dynamic)]) -> Dynamic {
  Dynamic.object([("kind", Text(kind)), ("name", Text(name)), ("spec", Dynamic.object(spec))])
}

## A network as a machine's spec writes it, for a provider's Pome.
pub fn network_spec(n: Network) -> Dynamic {
  n match {
    Dhcp -> Dynamic.object([("mode", Text("dhcp"))])
    Static(address: address, gateway: gateway, dns: dns) -> {
      Dynamic.object(
        [
          ("mode", Text("static")),
          ("address", Text(address)),
          ("gateway", Text(gateway)),
          ("dns", Items(dns.map(Text))),
        ],
      )
    }
  }
}

fn package_json(p: Package) -> Dynamic {
  resource(
    "NodePackage",
    "#{p.node}/#{p.name}",
    [("node", Text(p.node)), ("package", Text(p.name)), ("state", Text("Present"))],
  )
}

fn service_json(s: Service) -> Dynamic {
  resource(
    "NodeService",
    "#{s.node}/#{s.name}",
    [
      ("node", Text(s.node)),
      ("service", Text(s.name)),
      ("enabled", boolean(s.enabled)),
      ("running", boolean(s.running)),
    ],
  )
}

fn k3s_json(k: K3s) -> Dynamic {
  fields = [
    ("node", Text(k.node)),
    ("role", Text(k.role)),
    ("version", Text(k.version)),
    ("sha256", Text(k.sha256)),
  ]
  server = if k.server == "" { [] } else { [("server", Text(k.server))] }
  resource("NodeK3s", "#{k.node}/k3s", List.append(fields, server))
}

fn provided_json(p: Provided) -> Dynamic {
  Dynamic.object(
    [
      ("kind", Text(p.kind)),
      ("name", Text(p.name)),
      ("provider", Text(p.provider)),
      ("spec", Dynamic.object(p.spec)),
    ],
  )
}

fn graph_json(graph: Graph) -> Dynamic {
  resources = List.append(
    graph.packages.map(package_json),
    List.append(
      graph.services.map(service_json),
      List.append(graph.k3s_servers.map(k3s_json), graph.by_providers.map(provided_json)),
    ),
  )
  schema = if List.is_empty(graph.by_providers) { SCHEMA } else { SCHEMA_V2 }
  Dynamic.object([("schema", Text(schema)), ("resources", Items(resources))])
}

## The `mamela-graph/v1` (or v2) JSON text of `graph`, written by `x/json`: no whitespace, and object
## keys in sorted order (the order of `Map`).
pub fn to_json(graph: Graph) -> String {
  Json.to_string(graph_json(graph))
}

## Writes the graph as one line to standard output.
pub fn print(graph: Graph) {
  (use Console).print_line(to_json(graph))
}
