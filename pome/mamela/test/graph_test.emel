import Lib
import Dynamic
import Dynamic.Number

fn app() -> Lib.Node {
  Lib.Node(name: "app-server")
}

## A machine of a provider's kind, as a provider's Pome declares one.
fn machine(graph: Lib.Graph, name: String, network: Lib.Network) -> Lib.Graph {
  Lib.provided(graph, "test", "TestVM", name, [("network", Lib.network_spec(network))])
}

@test
fn empty_graph() {
  assert Lib.to_json(Lib.empty()) == "{\"resources\":[],\"schema\":\"mamela-graph/v1\"}"
}

@test
fn machine_package_and_service() {
  g = Lib.empty()
    |> machine("app-server", Lib.Dhcp)
    |> Lib.package(app(), "nginx")
    |> Lib.service(app(), "nginx", True, True)
  expected = String.concat(
    [
      "{\"resources\":[",
      "{\"kind\":\"NodePackage\",\"name\":\"app-server/nginx\",\"spec\":{\"node\":\"app-server\",\"package\":\"nginx\",\"state\":\"Present\"}},",
      "{\"kind\":\"NodeService\",\"name\":\"app-server/nginx\",\"spec\":{\"enabled\":true,\"node\":\"app-server\",\"running\":true,\"service\":\"nginx\"}},",
      "{\"kind\":\"TestVM\",\"name\":\"app-server\",\"provider\":\"test\",\"spec\":{\"network\":{\"mode\":\"dhcp\"}}}",
      "],\"schema\":\"mamela-graph/v2\"}",
    ],
  )
  assert Lib.to_json(g) == expected
}

@test
fn the_names_of_pome_0_2_do_the_same() {
  a = Lib.empty() |> Lib.package(app(), "nginx") |> Lib.service(app(), "nginx", True, False)
  b = Lib.empty() |> Lib.package_on(app(), "nginx") |> Lib.service_on(app(), "nginx", True, False)
  assert Lib.to_json(a) == Lib.to_json(b)
}

@test
fn same_graph_same_text() {
  g = Lib.empty() |> machine("app-server", Lib.Dhcp)
  assert Lib.to_json(g) == Lib.to_json(g)
}

@test
fn large_integers_are_written_as_integers() {
  # The Go side rejects floats and exponents, so integers must stay plain digits.
  g = Lib.empty()
    |> Lib.provided(
      "test",
      "TestVM",
      "big",
      [("memoryMiB", Dynamic.Number(Number.from_int(1048576)))],
    )
  assert Lib.to_json(g).contains("\"memoryMiB\":1048576")
}

@test
fn text_is_escaped() {
  # Names are validated on the Go side; the JSON must still stay well-formed for any text.
  g = Lib.empty() |> Lib.package(app(), "a\"b\\c\n\u{1}日本語")
  assert Lib.to_json(g).contains("\"package\":\"a\\\"b\\\\c\\n\\u0001日本語\"")
}

@test
fn provided_resources_make_a_v2_graph() {
  g = Lib.empty()
    |> Lib.provided("kv-example", "KVItem", "web", [("value", Dynamic.Text("v1"))])
  expected = String.concat(
    [
      "{\"resources\":[",
      "{\"kind\":\"KVItem\",\"name\":\"web\",\"provider\":\"kv-example\",\"spec\":{\"value\":\"v1\"}}",
      "],\"schema\":\"mamela-graph/v2\"}",
    ],
  )
  assert Lib.to_json(g) == expected
}

@test
fn k3s_cluster() {
  worker = Lib.Node(name: "worker")
  g = Lib.empty()
    |> machine("app-server", Lib.Dhcp)
    |> machine("worker", Lib.Dhcp)
    |> Lib.k3s_server(app(), "v1.33.5+k3s1", "00")
    |> Lib.k3s_agent(worker, app(), "v1.33.5+k3s1", "00")
  json = Lib.to_json(g)
  assert json.contains(
    "{\"kind\":\"NodeK3s\",\"name\":\"app-server/k3s\",\"spec\":{\"node\":\"app-server\",\"role\":\"server\",\"sha256\":\"00\",\"version\":\"v1.33.5+k3s1\"}}",
  )
  assert json.contains(
    "{\"kind\":\"NodeK3s\",\"name\":\"worker/k3s\",\"spec\":{\"node\":\"worker\",\"role\":\"agent\",\"server\":\"app-server\",\"sha256\":\"00\",\"version\":\"v1.33.5+k3s1\"}}",
  )
}

@test
fn static_network() {
  network = Lib.Static(
    address: "192.0.2.10/24",
    gateway: "192.0.2.1",
    dns: ["192.0.2.1", "198.51.100.1"],
  )
  json = Lib.to_json(Lib.empty() |> machine("db", network))
  assert json.contains(
    "\"network\":{\"address\":\"192.0.2.10/24\",\"dns\":[\"192.0.2.1\",\"198.51.100.1\"],\"gateway\":\"192.0.2.1\",\"mode\":\"static\"}",
  )
}
