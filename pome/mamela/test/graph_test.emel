import Lib
import Dynamic

fn app() -> Lib.Vm {
  Lib.Vm(name: "app-server", cpu: 2, memory_mib: 2048, disk_gib: 10, image: "ubuntu-24.04")
}

@test
fn empty_graph() {
  assert Lib.to_json(Lib.empty()) == "{\"resources\":[],\"schema\":\"mamela-graph/v1\"}"
}

@test
fn vm_package_and_service() {
  g = Lib.empty()
    |> Lib.vm(app())
    |> Lib.package(app(), "nginx")
    |> Lib.service(app(), "nginx", True, True)
  expected = String.concat(
    [
      "{\"resources\":[",
      "{\"kind\":\"VirtualMachine\",\"name\":\"app-server\",\"spec\":{\"cpu\":2,\"diskGiB\":10,\"image\":\"ubuntu-24.04\",\"memoryMiB\":2048}},",
      "{\"kind\":\"NodePackage\",\"name\":\"app-server/nginx\",\"spec\":{\"node\":\"app-server\",\"package\":\"nginx\",\"state\":\"Present\"}},",
      "{\"kind\":\"NodeService\",\"name\":\"app-server/nginx\",\"spec\":{\"enabled\":true,\"node\":\"app-server\",\"running\":true,\"service\":\"nginx\"}}",
      "],\"schema\":\"mamela-graph/v1\"}",
    ],
  )
  assert Lib.to_json(g) == expected
}

@test
fn same_graph_same_text() {
  g = Lib.empty() |> Lib.vm(app())
  assert Lib.to_json(g) == Lib.to_json(g)
}

@test
fn large_integers_are_written_as_integers() {
  # The Go side rejects floats and exponents, so integers must stay plain digits.
  vm = Lib.Vm(name: "big", cpu: 64, memory_mib: 1048576, disk_gib: 16384, image: "ubuntu-24.04")
  json = Lib.to_json(Lib.empty() |> Lib.vm(vm))
  assert json.contains("\"memoryMiB\":1048576")
  assert json.contains("\"diskGiB\":16384")
  assert json.contains("\"cpu\":64")
}

@test
fn text_is_escaped() {
  # Names are validated on the Go side; the JSON must still stay well-formed for any text.
  g = Lib.empty() |> Lib.package(app(), "a\"b\\c\n\u{1}日本語")
  assert Lib.to_json(g).contains("\"package\":\"a\\\"b\\\\c\\n\\u0001日本語\"")
}

@test
fn provided_resources_make_a_v2_graph() {
  g = Lib.empty()
    |> Lib.provided("kv-example", "KVItem", "web", [("value", Dynamic.Text("v1"))])
  expected = String.concat(
    [
      "{\"resources\":[",
      "{\"kind\":\"KVItem\",\"name\":\"web\",\"provider\":\"kv-example\",\"spec\":{\"value\":\"v1\"}}",
      "],\"schema\":\"mamela-graph/v2\"}",
    ],
  )
  assert Lib.to_json(g) == expected
}

@test
fn k3s_server() {
  g = Lib.empty()
    |> Lib.vm(app())
    |> Lib.k3s(app(), "v1.33.5+k3s1", "00")
  assert Lib.to_json(g).contains(
    "{\"kind\":\"NodeK3s\",\"name\":\"app-server/k3s\",\"spec\":{\"node\":\"app-server\",\"sha256\":\"00\",\"version\":\"v1.33.5+k3s1\"}}",
  )
}
