## K3s: a light Kubernetes on Mamela's machines, through mamelet (ADR 0007). A node runs k3s as a
## server, or as an agent of a server, of this exact release, pinned by the sha256 of its binary
## for the node's architecture (from the release's sha256sum file). Mamela writes the systemd unit
## itself and gives the cluster's nodes their join token; start it with
## `Mamela.service(graph, node, "k3s", True, True)`.
##
## These functions keep their form when k3s becomes a mamelet role (ADR 0007): only how they
## declare it changes.

import Mamela
import Mamela.{Node}
import Dynamic.{Text}

## Declares that `node` runs a k3s server of `version`, whose binary has `sha256`.
pub fn server(graph: Mamela.Graph, node: Node, version: String, sha256: String) -> Mamela.Graph {
  Mamela.on_node(
    graph,
    node,
    "NodeK3s",
    "#{node.name}/k3s",
    [("role", Text("server")), ("version", Text(version)), ("sha256", Text(sha256))],
  )
}

## Declares that `node` runs a k3s agent of `version` that joins the server on `server`.
pub fn agent(
  graph: Mamela.Graph,
  node: Node,
  server: Node,
  version: String,
  sha256: String,
) -> Mamela.Graph {
  Mamela.on_node(
    graph,
    node,
    "NodeK3s",
    "#{node.name}/k3s",
    [
      ("role", Text("agent")),
      ("server", Text(server.name)),
      ("version", Text(version)),
      ("sha256", Text(sha256)),
    ],
  )
}

## Declares that the k3s server on `server` has the manifest `name` in its auto-deploy directory
## (`mamela-<name>.yaml`): k3s applies what is in `content` (a workload, a `HelmChart`) with
## cluster-admin rights, and applies it again whenever it changes. The plan shows the whole
## content and asks for an approval; changing `content` is a new approval. A manifest that is no
## longer declared is not removed (its file stays; remove it by hand on the server).
pub fn manifest(graph: Mamela.Graph, server: Node, name: String, content: String) -> Mamela.Graph {
  Mamela.on_node(
    graph,
    server,
    "NodeK3sManifest",
    "#{server.name}/manifest/#{name}",
    [("name", Text(name)), ("content", Text(content))],
  )
}
